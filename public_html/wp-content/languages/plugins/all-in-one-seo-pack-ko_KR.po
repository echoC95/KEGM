msgstr "H2 태그가 페이지에서 발견되었습니다."

#: languages/aioseo-lite.php:3666
msgid "H2 tags were found on your page."
msgstr "페이지에서 H2 태그를 찾았습니다."

#: languages/aioseo-lite.php:5211
